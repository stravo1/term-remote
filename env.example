# Host settings for term-remote.
#
# Copy to ~/.config/term-remote/env and edit. The file is not in git, and both
# the provisioner and the CI deploy read it there. The shell environment wins
# over this file, and this file wins over the placeholder defaults.
#
# One KEY=VALUE per line. No quotes. Full list in ./setup-term-remote.sh --help.

TERM_REMOTE_DOMAIN=term.example.com
AUTHELIA_PORTAL_DOMAIN=auth.example.com
AUTHELIA_POLICY=two_factor

# Paths to the Caddy and Authelia configuration this provisioner patches.
# CADDY_CONFIG=/home/you/.config/caddy/Caddyfile
# AUTHELIA_CONFIG=/home/you/.config/authelia/configuration.yml
# AUTHELIA_PORT=9091
