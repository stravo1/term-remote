# >>> term-remote @DOMAIN@ (managed by setup-term-remote.sh)
@DOMAIN@ {
	route {
		request_header -Remote-User
		forward_auth 127.0.0.1:@AUTHELIA_PORT@ {
			uri /api/authz/forward-auth
			copy_headers Remote-User
		}

		# Only the pty endpoints need ttyd; the UI is served statically below.
		@terminal_api path /token /ws
		reverse_proxy @terminal_api 127.0.0.1:@PORT@

		# The shell must revalidate every load; a cached page paired with a fresh
		# script is a terminal that never connects.
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		header /vendor/* Cache-Control "public, max-age=31536000, immutable"
		header /icons/* Cache-Control "public, max-age=31536000, immutable"
		header /manifest.webmanifest Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json

		root * @APP_ROOT@
		file_server
	}
}
# <<< term-remote
