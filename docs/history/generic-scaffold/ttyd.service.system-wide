[Unit]
Description=ttyd web terminal
Documentation=https://github.com/tsl0922/ttyd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terminal
Group=terminal
WorkingDirectory=/home/terminal
Environment=TERM=xterm-256color
ExecStart=/usr/bin/ttyd \
	--interface 127.0.0.1 \
	--port 7681 \
	--writable \
	--max-clients 4 \
	tmux new -A -s main
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
